# Relay server settings (only needed if you run server/, not for GitHub Pages).
# Copy to .env and fill in. Never commit .env.

# Your aisstream.io API key.
AISSTREAM_API_KEY=

# "aisstream" (default) or "simulator" for synthetic traffic without a key.
AIS_SOURCE=aisstream

# Where the relay listens. Use HOST=0.0.0.0 when deploying or in Docker.
HOST=127.0.0.1
PORT=8787

# Comma-separated browser origins allowed to connect; empty allows any.
# Example: https://setspeed1000.github.io
ALLOWED_ORIGINS=

# Optional: limit the upstream subscription, aisstream format [[[lat,lon],[lat,lon]], ...]
# AIS_BOUNDING_BOXES=[[[49,-6],[52,3]]]

# Drop vessels with no position report for this many minutes.
VESSEL_TTL_MINUTES=60

# Snapshot file so restarts keep vessel names. Set empty to disable.
PERSIST_FILE=data/vessels.json
